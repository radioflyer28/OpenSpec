{
  "version": 1,
  "upstreamUrl": "https://github.com/Fission-AI/OpenSpec.git",
  "upstreamBranch": "main",
  "paths": [
    ".changeset/add-extension-seam.md",
    "docs/extensions.md",
    "src/cli/index.ts",
    "src/commands/extension.ts",
    "src/core/archive.ts",
    "src/core/command-generation/generator.ts",
    "src/core/completions/command-registry.ts",
    "src/core/extensions",
    "src/core/index.ts",
    "src/core/update.ts",
    "src/utils/command-references.ts",
    "test/commands/extension.test.ts",
    "test/core/archive-gates.test.ts",
    "test/core/extensions",
    "test/fixtures/extensions"
  ],
  "packageOverlay": {
    "exports": {
      "./extensions": {
        "types": "./dist/core/extensions/index.d.ts",
        "default": "./dist/core/extensions/index.js"
      }
    },
    "dependencies": { "semver": "^7.7.2" },
    "devDependencies": { "@types/semver": "^7.7.1" }
  },
  "verificationCommands": [
    ["pnpm", "install", "--no-frozen-lockfile"],
    ["pnpm", "run", "build"],
    ["pnpm", "exec", "tsc", "--noEmit"],
    ["pnpm", "exec", "vitest", "run", "test/core/extensions", "test/core/archive-gates.test.ts", "test/commands/extension.test.ts"]
  ]
}
